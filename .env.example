# ============================================================
#  WiseProfit - Sample Environment Variables
# ============================================================
#  Copy this file to ".env" and fill in real values for local dev.
#  On Render, set these in the dashboard's "Environment" tab.
# ============================================================

# ---- REQUIRED ----
# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Signing/encryption key for session tokens and stored MT5 credentials.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# WARNING: changing this invalidates all sessions.
SECRET_KEY=

# ---- OPTIONAL ----

# Gemini model used for SMC analysis.
GEMINI_MODEL=gemini-3.6-flash
# Optional account-compatible fallback. Leave empty to use only GEMINI_MODEL.
GEMINI_FALLBACK_MODEL=
# Number of attempts for temporary provider errors.
GEMINI_MODEL_RETRIES=2

# Risk controls
DAILY_PROFIT_TARGET=100
MAX_DAILY_SETUPS=5
MIN_SIGNAL_CONFIDENCE=0.70
MIN_RISK_REWARD=1.8
DEFAULT_LOT_SIZE=0.02
ENGINE_INTERVAL_SECONDS=60

# How long a sign-in session stays valid.
SESSION_TTL_HOURS=72

# Set to "true" to keep trading when the economic calendar feed is unreachable.
# Default (false) pauses trading rather than trading blind through news events.
NEWS_FILTER_FAIL_OPEN=false

# Database connection. If unset, the app falls back to a local SQLite file
# (./trading_platform.db). On Render, paste the *Internal* Database URL of
# your Render PostgreSQL instance, e.g.
#   postgresql://wiseprofit_user:password@dpg-xxxxx/wiseprofit
# (render automatically injects this if you link the database to the service).
# DATABASE_URL=

# Comma-separated list of origins allowed by CORS, or "*" for any origin.
# Example: "https://wiseprofit.com,https://www.wiseprofit.com"
ALLOWED_ORIGINS=*

# Set to "true" to disable the background trading engine (useful when you only
# want the static frontend + REST API, e.g. during Render free-tier sleep).
DISABLE_BOT=false

# Render always produces Gemini signals; the local Windows MT5 bot polls
# /api/signals and executes each signal on the local terminal.
BRIDGE_MODE=true

# How long a queued signal stays claimable by the local bot before it expires
# and the engine produces a fresh one next cycle (default 90 seconds).
PENDING_SIGNAL_TTL_SECONDS=90

# "development" enables uvicorn auto-reload when running `python main.py`.
# Anything else (including unset) is treated as production.
ENV=production

# Render injects $PORT automatically. Override only for local `python main.py`.
# PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO