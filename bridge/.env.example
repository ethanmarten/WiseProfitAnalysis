# WiseProfit Bridge — local environment
#
# Copy this file to ".env" next to local_mt5_bot.py and fill in your values.
# These are read by the LOCAL script only; they are NOT pushed to Render.

# Render URL of your deployed WiseProfit backend
RENDER_SERVER_URL=https://wiseprofitanalysis.onrender.com

# WiseProfit dashboard login (same email/password you use at /)
WP_EMAIL=your-dashboard-email@example.com
WP_PASSWORD=your-dashboard-password

# Symbol to trade. Must be available on the broker your MT5 terminal is
# logged in to. Defaults to XAUUSD.
MT5_SYMBOL=XAUUSD

# How often the bot polls Render for new signals (seconds). 4s is a good
# balance between latency and request volume.
POLL_INTERVAL_SECONDS=4

# HTTP timeout for each Render request (seconds).
REQUEST_TIMEOUT_SECONDS=6

# How often to upload M1/M5/M15 candles to the backend (seconds).
MARKET_DATA_INTERVAL_SECONDS=30

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO